# One work machine: a Lima VM holding one runner. Sourced by yad-machine on the
# host and by the provisioning scripts inside the machine, so it is plain shell
# assignments and nothing else.

# The VM's name, and the name `yad-machine shell` and `status` take.
MACHINE_NAME=example

# Size. Memory and disk in GiB. A run is one harness process plus whatever the
# repository's own tooling starts; 4 CPUs and 8 GiB carry two runs at once.
MACHINE_CPUS=4
MACHINE_MEMORY=8
MACHINE_DISK=60

# Which harnesses to install: claude, codex, or both.
MACHINE_HARNESSES="claude codex"

# Private addresses the runner's user may reach, space-separated. Empty means
# the internet only — not the host, the LAN or the tailnet (README.md, "What a
# machine can reach").
MACHINE_EGRESS_ALLOW=""

# Node's major version, from nodejs.org.
NODE_MAJOR=22

# Codex's version. Leave it unset for the one this yad was built against; a
# newer Codex runs, with a warning in `yad doctor` that its protocol may differ.
#CODEX_VERSION=0.157.1
